{
  "name": "@highstate/e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun run --bun vitest run src/harness",
    "test:e2e": "bun src/run.ts",
    "test:api": "bun src/run.ts api",
    "test:cli": "bun src/run.ts cli",
    "test:browser": "bun src/run.ts browser",
    "inspect": "bun src/inspect.ts",
    "inspect:runtime": "bun src/runtime-inspect.ts",
    "test:lifecycle": "bunx --bun nx run-many -t build --projects=@highstate/backend,@highstate/backend-api,@highstate/pulumi --parallel=2 && bun src/lifecycle-run.ts",
    "test:services": "bunx --bun nx run-many -t build --projects=@highstate/designer,@highstate/worker-sdk --parallel=2 && bun src/services-run.ts",
    "test:conformance": "bun run --bun vitest run src/conformance",
    "test:runtime-browser": "bun src/run.ts runtime-browser",
    "typecheck": "tsc --noEmit"
  },
  "nx": {
    "tags": ["e2e"],
    "targets": {
      "test": {
        "dependsOn": ["^build", { "target": "build", "projects": ["@highstate/pulumi"] }]
      },
      "test:e2e": { "cache": false }
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-node": "catalog:",
    "@highstate/api": "workspace:*",
    "@highstate/backend": "workspace:*",
    "@highstate/backend-api": "workspace:*",
    "@highstate/contract": "workspace:*",
    "@highstate/worker-sdk": "workspace:*",
    "@msgpack/msgpack": "^3.1.2",
    "@paralleldrive/cuid2": "^2.2.2",
    "age-encryption": "^0.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24",
    "bun-types": "^1.3.13",
    "typescript": "^5.9.3",
    "vitest": "catalog:"
  }
}
