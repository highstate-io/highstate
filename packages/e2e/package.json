{
  "name": "@highstate/e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun run --bun vitest run src/harness/registry.test.ts",
    "test:e2e": "bun src/run.ts",
    "test:conformance": "bun run --bun vitest run src/conformance",
    "typecheck": "tsc --noEmit",
    "biome:check": "biome check --error-on-warnings",
    "biome": "biome check --write --error-on-warnings"
  },
  "nx": {
    "tags": ["e2e"],
    "targets": {
      "test:e2e": { "cache": false },
      "test:conformance": { "cache": false }
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-node": "catalog:",
    "@highstate/api": "workspace:*",
    "@highstate/backend": "workspace:*",
    "@highstate/backend-api": "workspace:*",
    "@highstate/contract": "workspace:*",
    "age-encryption": "^0.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@biomejs/biome": "2.5.0",
    "@types/node": "^24",
    "bun-types": "^1.3.13",
    "typescript": "^5.9.3",
    "vitest": "catalog:"
  }
}
