{
  "name": "@highstate/api",
  "version": "0.27.0",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./src/api/v1.ts",
      "default": "./dist/api/v1.js"
    },
    "./worker.v1": {
      "types": "./src/api/worker.v1.ts",
      "default": "./dist/api/worker.v1.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "tags": [
      "platform"
    ]
  },
  "scripts": {
    "build": "highstate build",
    "generate-sdk": "buf lint && buf generate --include-imports",
    "proto:check": "buf format --diff --exit-code && buf lint",
    "test": "bun run --bun vitest run",
    "typecheck": "tsgo --noEmit --skipLibCheck",
    "biome": "biome check --write --unsafe --error-on-warnings",
    "biome:check": "biome check --error-on-warnings"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@highstate/cli": "workspace:*",
    "@typescript/native-preview": "^7.0.0-dev.20250920.1",
    "@bufbuild/buf": "catalog:",
    "@bufbuild/protoc-gen-es": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-node": "catalog:"
  },
  "repository": {
    "url": "https://github.com/highstate-io/highstate"
  }
}
