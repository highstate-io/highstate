/// A reusable Pulumi state backend configuration.
model PulumiStateBackend {
    /// The CUIDv2 of the Pulumi state backend.
    id String @id @default(cuid(2))

    /// The metadata managed by the backend.
    ///
    /// [CommonObjectMeta]
    meta Json

    /// The state backend specification, including its URL and encrypted authentication configuration.
    ///
    /// [PulumiStateBackendSpec]
    spec Json

    /// The time when the state backend was created.
    createdAt DateTime @default(now())

    /// The time when the state backend was last updated.
    updatedAt DateTime @updatedAt

    /// The projects using this state backend.
    projects Project[]
}
