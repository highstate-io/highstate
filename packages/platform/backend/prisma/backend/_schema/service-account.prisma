/// A backend service account represents a non-human identity in the backend authorization realm.
model BackendServiceAccount {
  /// The CUIDv2 of the backend service account.
  id String @id @default(cuid(2))

  /// The metadata of the backend service account managed by the backend.
  ///
  /// [CommonObjectMeta]
  meta Json

  /// The stable name of a backend-managed service account.
  ///
  /// Custom service accounts do not have a system name.
  systemName String? @unique

  /// The time when the backend service account was created.
  createdAt DateTime @default(now())

  /// The time when the backend service account was last updated.
  updatedAt DateTime @updatedAt

  /// The API keys impersonating this backend service account.
  apiKeys BackendApiKey[]

  /// The role bindings granting permissions to this backend service account.
  roleBindings ServiceAccountBackendRoleBinding[]

  /// The project bindings belonging to this backend service account.
  projectBindings BackendServiceAccountProjectBinding[]
}

/// A binding allowing a backend service account to assume a portable project service account.
model BackendServiceAccountProjectBinding {
  /// The ID of the backend service account receiving access.
  backendServiceAccountId String

  /// The ID of the project being accessed.
  projectId String

  /// The ID of the portable service account to assume in the project database.
  projectServiceAccountId String

  /// The time when the binding was created.
  createdAt DateTime @default(now())

  /// The backend service account receiving access.
  backendServiceAccount BackendServiceAccount @relation(fields: [backendServiceAccountId], references: [id], onDelete: Cascade)

  /// The project being accessed.
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([backendServiceAccountId, projectId])
  @@index([projectId])
}
