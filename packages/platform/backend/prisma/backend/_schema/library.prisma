enum LibrarySnapshotImageStatus {
    queued
    building
    pushing
    verifying
    ready
    failed
}

/// A backend-local image materialized from a portable project library snapshot.
///
/// The referenced snapshot lives in the project's separate database, so its ID and hash are stored without
/// a database relation. This record is disposable cache state and can be rebuilt from the snapshot.
model LibrarySnapshotImage {
    /// The CUIDv2 of the image cache entry.
    id String @id @default(cuid(2))

    /// The ID of the project that owns the snapshot.
    projectId String

    /// The opaque ID of the library snapshot in the project database.
    snapshotId String

    /// The canonical hash of the referenced library snapshot.
    snapshotHash String

    /// The ID of the runtime where the image is available.
    runtimeId String

    /// The current image materialization status.
    status LibrarySnapshotImageStatus @default(queued)

    /// The current build phase and progress details.
    progress Json?

    /// The runtime-local image reference, when available.
    imageRef String?

    /// The immutable OCI image digest, when available.
    imageDigest String?

    /// The hash reported by the completed image build.
    imageHash String?

    /// The most recent materialization error.
    error String?

    /// The time when the cache entry was created.
    createdAt DateTime @default(now())

    /// The time when the cache entry was last updated.
    updatedAt DateTime @updatedAt

    /// The time when image materialization completed.
    completedAt DateTime?

    /// The project that owns the snapshot.
    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    /// The runtime where the image is available.
    runtime ContainerRuntime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)

    @@unique([projectId, snapshotId, runtimeId])
    @@index([runtimeId, status])
}
