/// The aggregate execution state of a project operation.
enum OperationStatus {
    /// Created and waiting to begin execution.
    pending

    /// Executing the planned instance phases.
    running

    /// A failure was detected and remaining execution is being settled.
    failing

    /// Cancellation was requested and in-flight execution is being stopped.
    cancelling

    /// Finished successfully.
    completed

    /// Finished with an execution failure.
    failed

    /// Finished after cancellation was requested.
    cancelled
}

/// The requested operation performed against the selected instances.
enum OperationType {
    /// Reconcile deployed resources with the current instance configuration.
    update

    /// Calculate proposed changes without applying them.
    preview

    /// Remove the selected instances' deployed resources.
    destroy

    /// Destroy and then deploy the selected instances again.
    recreate

    /// Read current provider state into the recorded deployment state.
    refresh
}

/// The execution state of one instance within a project operation.
enum InstanceOperationStatus {
    /// Applying changes to the instance's resources.
    updating

    /// Processing triggers associated with the instance operation.
    processing_triggers

    /// Calculating proposed changes without applying them.
    previewing

    /// Removing the instance's deployed resources.
    destroying

    /// Refreshing the instance's recorded provider state.
    refreshing

    /// Waiting for dependencies or a runnable execution phase.
    pending

    /// Stopping the instance's in-flight execution after cancellation.
    cancelling

    /// The update completed successfully.
    updated

    /// The preview completed successfully.
    previewed

    /// The instance required no execution or was excluded by planning.
    skipped

    /// The instance's resource destruction completed successfully.
    destroyed

    /// The provider state refresh completed successfully.
    refreshed

    /// Execution terminated after cancellation was requested.
    cancelled

    /// Execution failed.
    failed
}

/// A project operation and its captured planning context.
model Operation {
    /// The CUIDv2 of the operation.
    id String @id @default(cuid(2))

    /// The metadata of the operation.
    ///
    /// [OperationMeta]
    meta Json

    /// The type of the operation.
    type OperationType

    /// The status of the operation.
    status OperationStatus @default(pending)

    /// The options of the operation.
    ///
    /// [OperationOptions]
    options Json

    /// The IDs of the instances that were exlicitly requested to operate on.
    ///
    /// [InstanceIds]
    requestedInstanceIds Json

    /// The execution phases of the operation.
    ///
    /// [OperationPhase[]]
    phases Json?

    /// The ID of the desired project library snapshot captured for planning this operation.
    librarySnapshotId String?

    /// The time when the operation started.
    startedAt DateTime @default(now())

    /// The time when the operation was last updated.
    updatedAt DateTime @updatedAt

    /// The time when the operation finished.
    finishedAt DateTime?

    /// The operation states associated with this operation.
    operationStates InstanceOperationState[]

    /// The logs of the operation.
    logs OperationLog[]

    /// The entity snapshots created by this operation.
    entitySnapshots EntitySnapshot[]

    /// The desired project library snapshot captured for planning this operation.
    librarySnapshot LibrarySnapshot? @relation(fields: [librarySnapshotId], references: [id])
}

/// The execution result and provenance of one instance in an operation.
model InstanceOperationState {
    /// The ID of the operation this state belongs to.
    operationId String

    /// The ID of the instance state affected by the operation.
    stateId String

    /// The enum representing the current status of the instance from the operation perspective.
    status InstanceOperationStatus

    /// The current count of the Pulumi resources being managed by this instance.
    currentResourceCount Int?

    /// The total count of the Pulumi resources that this instance is expected to manage.
    totalResourceCount Int?

    /// The snapshot of the instance model at the moment of operation start.
    ///
    /// [InstanceModel]
    model Json

    /// The snapshot of the resolved inputs at the moment of operation start.
    ///
    /// [InstanceResolvedInputs]
    resolvedInputs Json

    /// The ID of the library snapshot used to execute this instance operation.
    librarySnapshotId String?

    /// The ID of the package version supplying the targeted component implementation.
    libraryPackageVersionId String?

    /// The previously deployed package version when this operation performs an upgrade.
    previousLibraryPackageVersionId String?

    /// The content hash of the local development overlay used by this instance operation, when active.
    localOverlayHash String?

    /// The time when the operation on this instance started.
    /// Not populated on create, even if the instance is ready to start immediately.
    startedAt DateTime?

    /// The time when the operation on this instance finished.
    finishedAt DateTime?

    /// The operation this state belongs to.
    operation Operation @relation(fields: [operationId], references: [id])

    /// The instance this state belongs to.
    state InstanceState @relation(fields: [stateId], references: [id])

    /// The exact snapshot membership used to execute this instance operation.
    librarySnapshotVersion LibrarySnapshotVersion? @relation(fields: [librarySnapshotId, libraryPackageVersionId], references: [snapshotId, libraryPackageVersionId])

    /// The previously deployed package version when this operation performs an upgrade.
    previousLibraryPackageVersion LibraryPackageVersion? @relation("PreviousOperationPackageVersion", fields: [previousLibraryPackageVersionId], references: [id])

    @@id([operationId, stateId])
}

/// A persisted log entry emitted while executing a project operation.
model OperationLog {
    /// The ULID of the log. Also used to extract the timestamp.
    id String @id

    /// The ID of the operation this log belongs to.
    operationId String

    /// The ID of the instance state this log produced by.
    /// Can be `null` if the log is not associated with any instance.
    stateId String?

    /// Whether this log is a system/runtime message (vs unit output).
    isSystem Boolean @default(false)

    /// The content of the log.
    content String

    /// The operation this log belongs to.
    operation Operation @relation(fields: [operationId], references: [id])

    /// The instance this log produced by.
    /// Can be `null` if the log is not associated with any instance.
    state InstanceState? @relation(fields: [stateId], references: [id])
}
