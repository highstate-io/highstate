+#[cfg(test)]
+mod channel_axis_regression_tests {
+    use super::*;
+    use crate::Rectangle;
+
+    #[test]
+    fn channel_sweep_uses_the_same_parallel_axis_for_obstacles_and_segments() {
+        let router = ChannelRouter::with_nudge_distance(6.0);
+        for dimension in [0, 1] {
+            let point = |x, y| if dimension == 0 { Point::new(x, y) } else { Point::new(y, x) };
+            let mut route = Polygon::new();
+            route.push(point(0.0, 1000.0));
+            route.push(point(500.0, 1000.0));
+            let obstacle: Polygon = Rectangle::new_from_points(point(200.0, 1000.0), point(300.0, 1200.0)).into();
+            let routes = vec![route];
+            let segments = router.build_shift_segments_with_obstacles(&routes, dimension, &[obstacle]);
+            assert_eq!(segments.len(), 1);
+            assert_eq!(segments[0].max_limit, 1000.0,
+                "nudging must not move a boundary segment inside the obstacle in dimension {}", dimension);
+        }
+    }
+
+    #[test]
+    fn channel_sweep_retains_overlapping_obstacles_with_identical_perpendicular_bounds() {
+        let router = ChannelRouter::with_nudge_distance(6.0);
+        for dimension in [0, 1] {
+            let point = |x, y| if dimension == 0 { Point::new(x, y) } else { Point::new(y, x) };
+            let mut route = Polygon::new();
+            route.push(point(350.0, 1000.0));
+            route.push(point(450.0, 1000.0));
+            let obstacles: Vec<Polygon> = [(200.0, 300.0), (250.0, 500.0)].iter().map(|&(low, high)|
+                Rectangle::new_from_points(point(low, 1000.0), point(high, 1200.0)).into()
+            ).collect();
+            let routes = vec![route];
+            let segments = router.build_shift_segments_with_obstacles(&routes, dimension, &obstacles);
+            assert_eq!(segments[0].max_limit, 1000.0);
+        }
+    }
+}
