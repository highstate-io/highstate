{
  "name": "@highstate/docs",
  "private": true,
  "nx": {
    "targets": {
      "check": {
        "cache": true,
        "dependsOn": ["markdown:check", "prose:check"],
        "outputs": [],
        "executor": "nx:noop"
      },
      "markdown:check": {
        "cache": true,
        "executor": "nx:run-commands",
        "inputs": ["default", "{workspaceRoot}/.rumdl.toml"],
        "outputs": [],
        "options": {
          "command": "rumdl check packages/platform/docs/content --include '**/*.mdc' --enable MD001,MD009,MD012,MD031,MD040,MD046,MD048,MD050",
          "cwd": "{workspaceRoot}"
        }
      },
      "prose:check": {
        "cache": true,
        "executor": "nx:run-commands",
        "inputs": ["default", "{workspaceRoot}/.vale.ini", "{workspaceRoot}/.vale/**/*"],
        "outputs": [],
        "options": {
          "command": "vale packages/platform/docs/content",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "cd ../designer && nuxt prepare && cd ../docs/docus/layer && nuxt build && cd ../.. && NODE_OPTIONS=--max-old-space-size=4096 nuxt generate",
    "update-thumbnails": "bun ./scripts/update-thumbnails.mts"
  },
  "dependencies": {
    "@barzhsieh/nuxt-content-mermaid": "2.2.1",
    "@braintree/sanitize-url": "^7.1.2",
    "@highstate/contract": "workspace:*",
    "@highstate/designer": "workspace:*",
    "@highstate/library": "workspace:*",
    "@nuxt/content": "^3.7.1",
    "@nuxt/ui": "^4.0.1",
    "@nuxtjs/mdc": "^0.18.0",
    "better-sqlite3": "^12.4.1",
    "dayjs": "^1.11.19",
    "debug": "^4.4.3",
    "html2canvas-pro": "^1.6.3",
    "nuxt": "^4.1.2",
    "unist-util-visit": "^5.0.0",
    "zod": "^3",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@nuxt/image": "^2.0.0",
    "@nuxt/kit": "^4.4.2",
    "@nuxtjs/mcp-toolkit": "^0.15.0",
    "@nuxtjs/robots": "^6.0.8",
    "@vueuse/core": "^13.9.0",
    "@vueuse/nuxt": "12.0.0",
    "defu": "^6.1.7",
    "exsolve": "^1.0.8",
    "git-url-parse": "^16.1.0",
    "less": "^4.4.0",
    "nuxt-llms": "^0.2.0",
    "nuxt-og-image": "^6.4.8",
    "pkg-types": "^2.3.1",
    "playwright": "^1.57.0",
    "postcss-prefix-selector": "^2.1.1",
    "tailwindcss": "^4.2.4",
    "ufo": "^1.6.3",
    "vuetify": "^3.10.5",
    "yaml": "^2.8.3"
  },
  "version": "0.10.0",
  "repository": {
    "url": "https://github.com/highstate-io/highstate"
  }
}
