{
  "name": "@highstate/k8s.dashboard-worker",
  "private": true,
  "version": "0.28.3",
  "type": "module",
  "files": [
    "dist"
  ],
  "highstate": {
    "type": "worker"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "default",
          "^default",
          "{projectRoot}/package.json",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/bun.lock"
        ]
      },
      "build-plugin": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/plugin/package.json",
          "{projectRoot}/plugin/package-lock.json",
          "{projectRoot}/plugin/tsconfig.json",
          "{projectRoot}/plugin/src/**/*"
        ],
        "outputs": [
          "{projectRoot}/plugin/dist"
        ],
        "options": {
          "command": "npm ci && npm run build",
          "cwd": "{projectRoot}/plugin"
        }
      }
    },
    "tags": [
      "stdlib"
    ]
  },
  "scripts": {
    "build": "highstate build",
    "test": "bun run --bun vitest --run",
    "typecheck": "tsgo --noEmit --skipLibCheck",
    "biome": "biome check --write --unsafe --error-on-warnings",
    "biome:check": "biome check --error-on-warnings"
  },
  "dependencies": {
    "@highstate/contract": "workspace:*",
    "@highstate/worker-sdk": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@highstate/cli": "workspace:*",
    "@typescript/native-preview": "^7.0.0-dev.20250920.1",
    "bun-types": "^1.3.13"
  },
  "repository": {
    "url": "https://github.com/highstate-io/highstate"
  }
}
