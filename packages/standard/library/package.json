{
  "name": "@highstate/library",
  "version": "0.28.3",
  "type": "module",
  "highstate": {
    "type": "library",
    "release": {
      "group": "stdlib",
      "packages": [
        "@highstate/cilium",
        "@highstate/cloudflare",
        "@highstate/common",
        "@highstate/distributions",
        "@highstate/envoy",
        "@highstate/etcd",
        "@highstate/gcp",
        "@highstate/git",
        "@highstate/influxdb3",
        "@highstate/k3s",
        "@highstate/k8s",
        "@highstate/k8s.apps",
        "@highstate/k8s.game-servers",
        "@highstate/k8s.obfuscators",
        "@highstate/library",
        "@highstate/minio",
        "@highstate/mongodb",
        "@highstate/mullvad",
        "@highstate/mysql",
        "@highstate/netaminity",
        "@highstate/nixos",
        "@highstate/postgresql",
        "@highstate/proxmox",
        "@highstate/redis",
        "@highstate/restic",
        "@highstate/rustfs",
        "@highstate/sops",
        "@highstate/talos",
        "@highstate/timeweb",
        "@highstate/vault",
        "@highstate/wireguard",
        "@highstate/yandex"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "tags": [
      "stdlib"
    ]
  },
  "scripts": {
    "build": "highstate build",
    "typecheck": "tsgo --noEmit --skipLibCheck",
    "biome": "biome check --write --unsafe --error-on-warnings",
    "biome:check": "biome check --error-on-warnings"
  },
  "dependencies": {
    "@highstate/contract": "workspace:*",
    "remeda": "^2.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@highstate/cli": "workspace:*",
    "@typescript/native-preview": "^7.0.0-dev.20250920.1",
    "type-fest": "^4.41.0"
  },
  "repository": {
    "url": "https://github.com/highstate-io/highstate"
  }
}
