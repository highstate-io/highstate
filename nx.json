{
  "$schema": "https://raw.githubusercontent.com/nrwl/nx/refs/heads/master/packages/nx/schemas/nx-schema.json",
  "cli": {
    "packageManager": "bun"
  },
  "namedInputs": {
    "style": [
      "{workspaceRoot}/biome.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/.oxlintrc.json",
      "{workspaceRoot}/scripts/style/**/*",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock"
    ],
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/bin/**/*",
      "!{projectRoot}/.nuxt/**/*",
      "!{projectRoot}/.output/**/*",
      "!{projectRoot}/CHANGELOG.md",
      "!{projectRoot}/package.json",
      "!{projectRoot}/node_modules/**/*"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/.nuxt",
        "{projectRoot}/.output",
        "{projectRoot}/bin"
      ]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/coverage"]
    },
    "biome": {
      "cache": true,
      "inputs": ["default", "style"],
      "outputs": []
    },
    "biome:check": {
      "cache": true,
      "inputs": ["default", "style"],
      "outputs": []
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": []
    }
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": false
    }
  },
  "release": {
    "groups": {
      "platform": {
        "projects": ["tag:platform"],
        "projectsRelationship": "fixed"
      },
      "stdlib": {
        "projects": ["tag:stdlib"],
        "projectsRelationship": "fixed"
      }
    }
  },
  "nxCloudId": "68ec0fb6bfeabbab18190388",
  "analytics": false
}
