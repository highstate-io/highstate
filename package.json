{
  "name": "highstate",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/platform/*",
    "packages/standard/*",
    "packages/third-party/*",
    "packages/standard/*/generated/*",
    "packages/third-party/*/generated/*"
  ],
  "catalog": {
    "@bufbuild/buf": "^1.57.0",
    "@bufbuild/protobuf": "^2.14.0",
    "@bufbuild/protoc-gen-es": "^2.14.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.3.13",
  "repository": {
    "url": "https://github.com/highstate-io/highstate"
  },
  "scripts": {
    "ci:prepare": "scripts/bootstrap-cli.sh && bun install",
    "ci:release": "nx run-many -t test,build,biome:check,publish-images,typecheck",
    "ci:verify": "nx affected --base=origin/main -t test,biome:check,typecheck,check,links",
    "dev:build": "nx run-many -t build --exclude @highstate/designer --exclude @highstate/docs",
    "update-diagrams": "ts-node --esm scripts/update-diagrams.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@highstate/cli": "workspace:*",
    "@nx/node": "21.6.4",
    "@types/node": "^24",
    "bun-types": "^1.3.13",
    "nx": "^22.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "catalog:",
    "zod": "^4.3.6"
  }
}
