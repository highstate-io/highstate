{
  "name": "highstate",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/platform/*",
    "packages/standard/*",
    "packages/third-party/*",
    "packages/standard/*/generated/*",
    "packages/third-party/*/generated/*"
  ],
  "catalog": {
    "@bufbuild/buf": "^1.57.0",
    "@bufbuild/protobuf": "^2.14.0",
    "@bufbuild/protoc-gen-es": "^2.14.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.3.13",
  "repository": {
    "url": "https://github.com/highstate-io/highstate"
  },
  "scripts": {
    "ci:prepare": "scripts/bootstrap-cli.sh && bun install",
    "ci:release": "bun run release-groups:update && nx run-many -t test,build,biome:check,publish-images,typecheck",
    "ci:verify": "bun run changesets:check && bun run release-groups:check && bun run test:scripts && bun run lint && nx affected --base=origin/main -t test,typecheck,check,links",
    "lint": "biome check --error-on-warnings && bun scripts/style/check.ts",
    "lint:fix": "bun scripts/style/check.ts --fix && biome check --write --error-on-warnings",
    "changeset": "changeset",
    "release:version": "changeset version && bun run release:lockfile && bun install",
    "release:publish": "nx release publish --groups=platform,stdlib",
    "release:github": "bun scripts/create-github-releases.ts",
    "release:lockfile": "bun scripts/synchronize-workspace-lockfile.ts",
    "test:scripts": "bun run --bun vitest run scripts",
    "changesets:check": "bun scripts/check-changesets.ts",
    "dev:build": "nx run-many -t build --exclude @highstate/designer --exclude @highstate/docs",
    "release-groups:check": "bun scripts/release-groups.ts --check",
    "release-groups:update": "bun scripts/release-groups.ts",
    "update-diagrams": "ts-node --esm scripts/update-diagrams.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.7",
    "@highstate/cli": "workspace:*",
    "@nx/node": "21.6.4",
    "@types/node": "^24",
    "bun-types": "^1.3.13",
    "eslint": "9.39.4",
    "eslint-plugin-jsdoc": "61.7.1",
    "nx": "^22.7.5",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "pkg-pr-new": "^0.0.88",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "catalog:",
    "vue-eslint-parser": "10.4.1",
    "zod": "^4.3.6"
  }
}
